# Chép thành .env rồi sửa. Mọi thứ mặc định chạy CỤC BỘ, không gửi gì ra ngoài.

# --- Server giao diện ---
HOST=127.0.0.1
PORT=7870
# DATA_DIR=./data

# --- Model chat (llama.cpp llama-server, xem scripts/run_llm_llamacpp.sh) ---
LLM_API_BASE=http://127.0.0.1:8080/v1
LLM_MODEL=qwen3.8-27b
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.3
LLM_ENABLE_THINKING=0

# --- Embedding (llama.cpp --embedding, xem scripts/run_embed_llamacpp.sh) ---
EMBED_API_BASE=http://127.0.0.1:8081/v1
EMBED_MODEL=qwen3-embedding-0.6b
# Qwen3-Embedding cần câu dẫn cho truy vấn; model embedding khác thì để trống dòng này:
# EMBED_QUERY_PREFIX=

# --- Truy hồi ---
TOP_K=8
CONTEXT_CHARS=24000

# --- Nạp tài liệu (MinerU 4) ---
# basic    = CPU, không cần model phụ. Tốt với PDF có lớp chữ; KÉM với bản scan tiếng Việt.
# standard = cần model MinerU2.5 (đọc scan tiếng Việt tốt). Qua server riêng (MINERU_VLM_URL)
#            hoặc để trống URL cho MinerU tự chạy engine cục bộ (MINERU_VLM_ENGINE).
MINERU_TIER=basic
# MINERU_VLM_URL=http://127.0.0.1:8010
# MINERU_VLM_MODEL=mineru25
# MINERU_VLM_ENGINE=llama-cpp
# Model nhỏ của MinerU chạy ONNX/CPU (mặc định trong code) — không tốn VRAM:
# MINERU_MODEL_SMALL_BACKEND=onnx
# MINERU_DEVICE_MODE=cpu
